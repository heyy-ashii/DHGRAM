# --- Datastore: MongoDB (default) ---
# Required unless you use the Google Sheets datastore below. In Sheets mode this is ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dhgram
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Email OTP (Gmail: create an App Password at https://myaccount.google.com/apppasswords) ---
# If unset, codes are printed to the server log (and returned as devCode outside production).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dhgram.app@gmail.com
SMTP_PASS=
MAIL_FROM="DHGRAM <dhgram.app@gmail.com>"

# --- Google Sheets datastore (optional, replaces MongoDB entirely) ---
# Leave SHEETS_API_URL empty to keep everything in MongoDB.
# When set, users, OTPs, chats and posts all live in the Sheet. Keep the
# spreadsheet PRIVATE; access is gated by the token below.
# See docs/google-sheets.md. The token must match SHEETS_TOKEN in the Apps Script properties.
SHEETS_API_URL=
SHEETS_API_TOKEN=
SHEETS_TIMEOUT_MS=8000

# --- Student roster for signup (optional) ---
# A public Google Sheet of students allowed to create an account. Signup checks
# the name and admission number against it. Share it as "anyone with the link".
# ROSTER_CSV is only used by tests to read the roster inline instead of the network.
ROSTER_SHEET_ID=104OzyflQpqmew1zUU-v4m1UGSaEr8jX5vHNor3xev_U
ROSTER_CACHE_MINUTES=10
ROSTER_CSV=

# --- Supabase datastore (optional, replaces MongoDB entirely) ---
# Setting SUPABASE_DB_URL switches the app to Postgres. See docs/supabase.md.
# Take the string from Supabase > Project Settings > Database > Connection string >
# Connection pooling (URI). Use the pooler port 6543 on serverless.
# The tables are created automatically on the first API request (or run
# `npm run supabase:apply` by hand).
SUPABASE_URL=
SUPABASE_DB_URL=
# Not required for the Postgres driver. Kept for Supabase Auth / REST work.
# The secret key bypasses Row Level Security: server-side only.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_TIMEOUT_MS=10000
# Set to false to stop the app applying migrations on the first request.
SUPABASE_AUTO_MIGRATE=true

# --- Optional ---
JWT_EXPIRES_IN=7d
# Comma-separated extra origins allowed to call the API with credentials (not needed when frontend and API share a domain)
CORS_ORIGINS=
# Chat retention: messages older than this many days are deleted automatically.
CHAT_RETENTION_DAYS=30
# Bearer secret for the daily cleanup cron (Vercel Cron sends CRON_SECRET automatically).
# Set the same value in the Vercel project env. Without it the cleanup endpoint returns 503.
CRON_SECRET=
# Local dev only
PORT=4000
